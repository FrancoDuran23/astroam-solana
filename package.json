{
  "name": "astroam-solana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "server": "node --experimental-strip-types src/server/main.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "solana:test": "cargo test --manifest-path programs/astroam-escrow/Cargo.toml -- --test-threads=1",
    "solana:deploy": "node --experimental-strip-types scripts/deploy-solana-escrow.ts",
    "meter:demo": "node src/meter/demo-meter.ts"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "@solana/web3.js": "1.98.4",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
