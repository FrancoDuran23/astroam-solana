# AstroAm server configuration. Copy to .env; every value has a working
# default for local demos, so `cp .env.example .env` is enough to start.

# ---------------------------------------------------------------------------
# server
# ---------------------------------------------------------------------------

PORT=8080
# Bind address. 0.0.0.0 is what a container host (Render, Fly) needs.
HOST=0.0.0.0

# Where missions, eSIM records and webhook logs are stored (JSON files).
DATA_DIR=./data

# ---------------------------------------------------------------------------
# payments — the chain the traveler pays on
# ---------------------------------------------------------------------------

# Payment rail (src/rails/). "fake" (default) keeps demo metering in memory:
# vouchers are signed off-chain and nothing is debited per MB. The USDC
# itself moves on Solana only when the traveler's wallet sends deposit/close.
PAYMENT_RAIL=fake

# Solana devnet escrow. These public addresses are the program
# `npm run solana:deploy` printed and the payee it was initialized with.
# Do not replace them with an address the deploy script did not print.
# The first program (8QXPo6yVxZuC3goYzHVLsxVkE1J6BaEqZvfW9e3Do2uq) has no
# meter key and cannot settle with a meter voucher.
# Program: https://explorer.solana.com/address/HgrzvLkRfWaH5t4NTaLpv952YXZdzsrmZrC9NZVSoRmk?cluster=devnet
# Config:  https://explorer.solana.com/address/4igZjvwU4sfiu4dsRAzcyk2PqQGBgZqhJ8ddnczXpy3o?cluster=devnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=HgrzvLkRfWaH5t4NTaLpv952YXZdzsrmZrC9NZVSoRmk
SOLANA_PAYEE_ADDRESS=9NMAvdKGJibTUFW4mWRfVd4sZRpLNo3fQCQMqdrXXV89
SOLANA_TIMEOUT_SECONDS=604800
# Circle's published Solana devnet USDC mint (6 decimals, SPL Token).
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---------------------------------------------------------------------------
# automatic fund flow — docs/decisions/automate-fund-flow-citrus-bridge.md
# ---------------------------------------------------------------------------

# true for a program that stores a meter key (the one above). The deposit
# may register a session key. That key does not sign vouchers. Leave it empty
# if SOLANA_PROGRAM_ID points at the first program, which has no meter field.
SOLANA_ESCROW_SESSION_KEYS=true

# Public key of the meter that signs cumulative vouchers, as `npm run
# solana:deploy` printed it and the program config stores it. Do not invent one.
SOLANA_METER_PUBKEY=3WqaNhVVCCnabBLGA9YWviQHDvo6fTmX1Y9otcmsdB7k

# Keypair file (solana-keygen JSON) whose public key is SOLANA_METER_PUBKEY.
# The backend signs usage vouchers with it. Absolute path (no ~). Never
# logged and never committed. Without it the API cannot sign vouchers.
SOLANA_METER_KEYPAIR=

# Same 64-byte JSON array, inline, for a host with no secret file (Render or
# Fly). Leave empty in git. Never commit a real value.
SOLANA_METER_KEYPAIR_JSON=

# Keypair file (solana-keygen JSON) the backend pays fees with. With it the
# backend reads each deposit from the escrow, funds the eSIM in tranches, and
# sends the checkpoint, the claims and the close itself. It does not choose
# the amount: that comes from the meter voucher. Needs SOLANA_METER_KEYPAIR.
# Never logged.
SOLANA_OPERATOR_KEYPAIR=

# Inline form of SOLANA_OPERATOR_KEYPAIR. Leave empty in git.
SOLANA_OPERATOR_KEYPAIR_JSON=

# How often the fund-flow job runs, ms.
FUND_FLOW_INTERVAL_MS=60000

# eSIM funding: one tranche (USD cents) ahead of what the vouchers cover, and
# the smallest fund worth a provider call. What AstroAm can lose is one tranche.
FUNDING_TRANCHE_CENTS=250
FUNDING_MIN_CENTS=50

# What the traveler pays over the provider's cost, and USD per USDC (basis points).
MARKUP_BPS=15000
USDC_USD_RATE_BPS=10000

# Uncollected voucher amount (USDC) that triggers a claim on the escrow.
CLAIM_MIN_USDC=2

# The backend closes a trip this long before the escrow's refund timeout
# (seconds), this long after its end date, and after this long with no new
# usage (0 = never close for inactivity). A timeout pays the last attested
# amount to the payee and refunds only the rest.
ESCROW_CLOSE_MARGIN_SECONDS=86400
ESCROW_TRIP_END_GRACE_SECONDS=86400
ESCROW_IDLE_CLOSE_SECONDS=0

# Bridge liquidation address (Solana, USDC): collected USDC is swept there
# once the payee holds TREASURY_SWEEP_MIN_USDC. The operator key must be the
# payee. Empty = collected USDC stays with the payee.
BRIDGE_LIQUIDATION_ADDRESS=
TREASURY_SWEEP_MIN_USDC=5

# ---------------------------------------------------------------------------
# connectivity — Citrus Mobile (eSIM provisioning, usage, cutoff)
# ---------------------------------------------------------------------------

# "fake" (default) uses an in-memory provider (demos and tests, no
# credentials); "citrus" talks to the real Citrus reseller API.
CONNECTIVITY_PROVIDER=fake

# Reseller API key (rsk_…). Required when CONNECTIVITY_PROVIDER=citrus.
# Never logged.
CITRUS_API_KEY=

# Override the Citrus API base URL (optional).
CITRUS_BASE_URL=

# Shared secret that verifies inbound Citrus webhooks (x-signature). Without
# it the server runs without the /citrus/webhooks route.
CITRUS_WEBHOOK_SECRET=

# Timeout (ms) per Citrus HTTP request.
CITRUS_REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# pricing
# ---------------------------------------------------------------------------

# Price per decimal MB in raw units (1 raw = 1e-7 USDC). Leave empty to use
# each destination's own rate, the one the app shows (e.g. Brazil 0.0025
# USDC/MB = 25000). Set it only to force one price for every destination.
PRICE_PER_MB_RAW=

# ---------------------------------------------------------------------------
# product API — the frontend's /api
# ---------------------------------------------------------------------------

# Live mode: true requires a live payment rail and Citrus, and an access
# token on every route that changes data.
ASTROAM_LIVE_ENABLED=false

# Token required as `Authorization: Bearer <token>` on mutable routes in
# live mode.
# ASTROAM_DEMO_ACCESS_TOKEN=

# Allowed CORS origin for the frontend.
FRONTEND_ORIGIN=http://localhost:5173

# Lets the app inject test traffic (POST /api/missions/:id/demo-traffic).
ENABLE_DEMO_TRAFFIC=true
