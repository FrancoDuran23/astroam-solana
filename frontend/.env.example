# ASTROAM Frontend Configuration (PUBLIC ONLY)
# Never place private API keys, secrets, or seeds in this file.

# Operation mode: "api" (connect to real backend) | "demo" (isolated local mock)
VITE_ASTROAM_MODE=api

# Base URL of the ASTROAM backend API, INCLUDING the /api prefix
# (e.g. https://api.example.com/api). Leave it unset in local dev: the app
# then calls /api and Vite proxies it to http://localhost:8080.
# VITE_API_BASE_URL=http://localhost:8080/api
# Production: set this to the hosted API, including /api.
# Example: https://astroam-api.example.com/api

# The traveler app reads the program id from the API, not from these lines.
# Public devnet addresses (same as the root .env.example). Do not replace them.
# Program: https://explorer.solana.com/address/HgrzvLkRfWaH5t4NTaLpv952YXZdzsrmZrC9NZVSoRmk?cluster=devnet
# Config:  https://explorer.solana.com/address/4igZjvwU4sfiu4dsRAzcyk2PqQGBgZqhJ8ddnczXpy3o?cluster=devnet
# VITE_SOLANA_CLUSTER=devnet
